{
  "version": 1,
  "description": "Capability-tier routing policy. Data only: changing a model name or a tier mapping must never require editing AGENTS.md or any harness code. Subscription authentication is not subscription usage: an account is dispatchable only through an execution mechanism that consumes its plan's included usage. A logical account slot is not an auth context either: a slot executed through a directory-isolated runtime declares the concrete accountDir its credential lives in, and the mechanism declares the provider id that credential is filed under. `provider` is the vendor axis (tier lookup, cross-provider review independence); `authProvider` is what the runtime is invoked and probed with. They are not interchangeable.",
  "defaultParallel": 1,
  "effortLadder": [
    "low",
    "medium",
    "high",
    "xhigh",
    "max"
  ],
  "effortRequiringJustification": [
    "xhigh",
    "max"
  ],
  "accounts": {
    "CLAUDE_A": {
      "provider": "anthropic",
      "auth": "subscription",
      "execution": "claude-code-cli",
      "plan": "claude_pro",
      "conceptualRole": "architecture / orchestration candidate",
      "authStatus": "authenticated"
    },
    "CLAUDE_B": {
      "provider": "anthropic",
      "auth": "subscription",
      "execution": "claude-code-cli",
      "plan": "claude_pro",
      "conceptualRole": "independent Claude reviewer or second hard task",
      "authStatus": "setup-required"
    },
    "GPT_A": {
      "provider": "openai",
      "auth": "subscription",
      "execution": "pi-openai-chatgpt-oauth",
      "accountDir": "~/.pi/accounts/gpt_a",
      "plan": "chatgpt_plus",
      "conceptualRole": "primary bounded executor",
      "authStatus": "authenticated"
    },
    "GPT_B": {
      "provider": "openai",
      "auth": "subscription",
      "execution": "pi-openai-chatgpt-oauth",
      "accountDir": "~/.pi/accounts/gpt_b",
      "plan": "chatgpt_plus",
      "conceptualRole": "scout / second executor / independent reviewer",
      "authStatus": "setup-required"
    }
  },
  "executionMechanisms": {
    "claude-code-cli": {
      "runtime": "claude-code",
      "provider": "anthropic",
      "consumesPlanIncludedUsage": true,
      "basis": "Claude Code signed in with a Claude Pro account draws that plan's included usage; observed locally as claude_pro / stripe_subscription (docs/reviews/2026-08-20-pi-harness-implementation.md, section C)."
    },
    "pi-anthropic-oauth": {
      "runtime": "pi",
      "provider": "anthropic",
      "consumesPlanIncludedUsage": false,
      "basis": "Pi provider documentation: Claude Pro/Max credentials used through Pi are billed per token as Anthropic extra usage rather than against plan limits. Subscription authentication, metered execution — not dispatchable here."
    },
    "pi-openai-chatgpt-oauth": {
      "runtime": "pi",
      "provider": "openai",
      "authProvider": "openai-codex",
      "accountDirEnv": "PI_CODING_AGENT_DIR",
      "authFile": "auth.json",
      "readinessCommand": [
        "pi",
        "auth",
        "check",
        "--provider",
        "openai-codex",
        "--json"
      ],
      "consumesPlanIncludedUsage": true,
      "basis": "Pi provider documentation: the OpenAI provider signs in with the Codex ChatGPT Plus/Pro OAuth path, which consumes that plan's included Codex usage. That credential is filed under provider id openai-codex, not openai; probing plain openai reports credentials_not_configured for an account that is in fact ready (observed 2026-08-20 against ~/.pi/accounts/gpt_a)."
    }
  },
  "tiers": {
    "THROUGHPUT": {
      "anthropic": {
        "model": "claude-haiku-4-5"
      },
      "openai": {
        "model": "gpt-5.6-luna"
      }
    },
    "BALANCED": {
      "anthropic": {
        "model": "claude-sonnet-5"
      },
      "openai": {
        "model": "gpt-5.6-terra"
      }
    },
    "FRONTIER": {
      "anthropic": {
        "model": "claude-opus-5",
        "alternates": [
          "claude-fable-5"
        ]
      },
      "openai": {
        "model": "gpt-5.6-sol"
      }
    }
  },
  "taskClasses": {
    "T0": {
      "label": "retrieval / mechanical",
      "tier": "THROUGHPUT",
      "effort": "low",
      "risk": 0,
      "maxParallel": 4,
      "preferAccounts": [
        "CLAUDE_A",
        "GPT_A",
        "CLAUDE_B",
        "GPT_B"
      ]
    },
    "T1": {
      "label": "bounded coding",
      "tier": "BALANCED",
      "effort": "medium",
      "risk": 1,
      "maxParallel": 2,
      "preferAccounts": [
        "GPT_A",
        "GPT_B",
        "CLAUDE_B",
        "CLAUDE_A"
      ]
    },
    "T2": {
      "label": "difficult debugging",
      "tier": "BALANCED",
      "escalateTier": "FRONTIER",
      "effort": "high",
      "risk": 2,
      "maxParallel": 1,
      "preferAccounts": [
        "CLAUDE_A",
        "GPT_A",
        "CLAUDE_B",
        "GPT_B"
      ]
    },
    "T3": {
      "label": "concurrency / architecture / contradictory evidence",
      "tier": "FRONTIER",
      "effort": "high",
      "risk": 3,
      "maxParallel": 1,
      "preferAccounts": [
        "CLAUDE_A",
        "CLAUDE_B",
        "GPT_A",
        "GPT_B"
      ]
    },
    "T4": {
      "label": "disputed / release-critical decision",
      "tier": "FRONTIER",
      "effort": "high",
      "risk": 4,
      "maxParallel": 2,
      "preferAccounts": [
        "CLAUDE_A",
        "GPT_A",
        "CLAUDE_B",
        "GPT_B"
      ]
    }
  },
  "providerPreferences": [
    {
      "tag": "git-archaeology",
      "provider": "anthropic",
      "basis": "arena-bash-recovery-disjoint-ci"
    },
    {
      "tag": "native-concurrency",
      "provider": "anthropic",
      "basis": "arena-bash-recovery-disjoint-ci"
    }
  ],
  "evidence": {
    "arena": {
      "source": "https://arena.ai/leaderboard/agent",
      "retrieved": "2026-08-20",
      "leaderboardDated": "2026-08-18",
      "standing": "routing prior, not an oracle; never overrides a deterministic gate or a reproduction",
      "detail": "docs/architecture/agent-harness.md"
    }
  },
  "billing": {
    "authorizedAuth": [
      "subscription"
    ],
    "apiBillingAuthorized": false,
    "usageCreditFallbackAuthorized": false
  }
}
